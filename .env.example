# ── Writer's Room: Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in your keys.

# ── Groq (Primary LLM) ───────────────────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Gemini (Image Generation) ────────────────────────────────────────
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Model overrides (optional — defaults are set in config.py) ───────────────
# ACTIVE_PROVIDER=groq           # groq | google | ollama
# GROQ_MODEL=llama-3.3-70b-versatile
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ── ComfyUI (Local Image Generation — Default) ────────────────────────────
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW=./comfyui/image_flux2_text_to_image_9b.json
COMFYUI_TIMEOUT=300
IMAGE_GEN_BACKEND=comfyui
